{
  "AllowedHosts": "*",
  "DemoData": {
    "Enabled": false
  },
  "ConnectionStrings": {
    "BrewNestDatabase": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7240",
      "http://localhost:5240"
    ]
  },
  "Jwt": {
    "Issuer": "BrewNest.Api",
    "Audience": "BrewNest.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Inventory": {
    "Expiry": {
      "FirstAlertDays": 15,
      "EscalatedAlertDays": 7,
      "CriticalAlertDays": 3
    }
  },
  "Sales": {
    "DocumentNumbers": {
      "OrderPrefix": "SO",
      "BillPrefix": "INV"
    }
  },
  "Kitchen": {
    "DocumentNumbers": {
      "TicketPrefix": "KOT"
    }
  },
  "Production": {
    "DocumentNumbers": {
      "PlanPrefix": "PP",
      "OrderPrefix": "PRD"
    }
  },
  "Procurement": {
    "DocumentNumbers": {
      "RequisitionPrefix": "PR",
      "RfqPrefix": "RFQ",
      "OrderPrefix": "PO",
      "ReceiptPrefix": "GRN",
      "ReturnPrefix": "VRN"
    }
  },
  "Returns": {
    "DocumentNumbers": {
      "ReturnPrefix": "RET",
      "RmaPrefix": "RMA",
      "CreditPrefix": "CN",
      "VoidPrefix": "VOID"
    }
  },
  "Payments": {
    "Simulation": {
      "DeclinePayerReference": "+999000000000"
    },
    "DocumentNumbers": {
      "PaymentPrefix": "PAY",
      "RefundPrefix": "RFND"
    }
  },
  "Identity": {
    "DevelopmentSeed": {
      "Enabled": false
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
