<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Test pure frontend helpers without introducing a backend-to-WASM project reference. -->
  <ItemGroup>
    <Compile Include="../../../frontend/src/BrewNest.Web/Shared/WorkspaceDirectory.cs" Link="Frontend/WorkspaceDirectory.cs" />
    <Compile Include="../../../frontend/src/BrewNest.Web/Services/ApiProblemMessage.cs" Link="Frontend/ApiProblemMessage.cs" />
    <None Include="../../../frontend/src/BrewNest.Web/**/*.razor" Exclude="../../../frontend/src/BrewNest.Web/obj/**;../../../frontend/src/BrewNest.Web/bin/**" Link="FrontendPages/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BrewNest.BuildingBlocks\BrewNest.BuildingBlocks.csproj" />
    <ProjectReference Include="..\..\..\shared\BrewNest.Contracts\BrewNest.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Administration\BrewNest.Modules.Administration.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Catalog\BrewNest.Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Delivery\BrewNest.Modules.Delivery.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Finance\BrewNest.Modules.Finance.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Identity\BrewNest.Modules.Identity.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Inventory\BrewNest.Modules.Inventory.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Kitchen\BrewNest.Modules.Kitchen.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Payments\BrewNest.Modules.Payments.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Procurement\BrewNest.Modules.Procurement.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Production\BrewNest.Modules.Production.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Reporting\BrewNest.Modules.Reporting.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Returns\BrewNest.Modules.Returns.csproj" />
    <ProjectReference Include="..\..\src\Modules\BrewNest.Modules.Sales\BrewNest.Modules.Sales.csproj" />
  </ItemGroup>

</Project>
