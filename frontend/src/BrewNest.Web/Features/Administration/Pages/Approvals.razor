@page "/administration/approvals"
@attribute [Authorize(Policy = AdministrationPermissionNames.ApprovalsRead)]
@inject AdministrationApiClient ApiClient
@inject IdentitySessionState Session
<PageTitle>Approval rules · BrewNest</PageTitle>
<section class="identity-heading"><div><span class="kicker">GOVERNANCE</span><h1>Approval rules</h1><p>Configurable role routes and amount tiers; no approval thresholds are hard-coded in application logic.</p></div></section>
@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
@if(CanManage){<section class="identity-panel"><h2>Create policy</h2><EditForm Model="form" OnValidSubmit="CreateAsync"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><div><label>Process code</label><InputText class="form-control" @bind-Value="form.ProcessCode"/></div><div><label>Name</label><InputText class="form-control" @bind-Value="form.Name"/></div><div><label>Minimum PKR</label><InputNumber class="form-control" @bind-Value="form.MinimumAmount"/></div><div><label>Maximum PKR</label><InputNumber class="form-control" @bind-Value="form.MaximumAmount"/></div><div><label>Mode</label><InputSelect class="form-control" @bind-Value="form.ApprovalMode"><option>All</option><option>Any</option></InputSelect></div><div><label>Roles (comma separated)</label><InputText class="form-control" @bind-Value="form.RequiredRoles"/></div></div><button class="identity-primary-button" type="submit">Create policy</button></EditForm></section>}
<section class="identity-panel"><h2>Policies</h2>@foreach (var group in policies.GroupBy(item => item.ProcessCode)) { <h3>@group.Key</h3>@foreach (var policy in group) { <div class="identity-role-row"><span><strong>@policy.Name</strong><small>@Range(policy) · @policy.ApprovalMode · @string.Join(" → ", policy.RequiredRoles)</small></span>@if(CanManage){<button class="identity-secondary-button" type="button" @onclick="()=>ToggleAsync(policy)">@(policy.IsActive?"Deactivate":"Activate")</button>}else{<span>@(policy.IsActive?"Active":"Inactive")</span>}</div> }}</section>
@code { private ApprovalPolicyResponse[] policies=[]; private ApprovalPolicyFormModel form=new(); private string? message; private bool error; private bool CanManage=>Session.CurrentUser?.Permissions.Contains(AdministrationPermissionNames.ApprovalsManage,StringComparer.Ordinal)==true; protected override async Task OnInitializedAsync()=>policies=await ApiClient.GetApprovalsAsync(); private async Task CreateAsync(){try{var roles=form.RequiredRoles.Split(',',StringSplitOptions.RemoveEmptyEntries|StringSplitOptions.TrimEntries);await ApiClient.CreateApprovalAsync(new(form.ProcessCode,form.Name,form.MinimumAmount,form.MaximumAmount,form.ApprovalMode,roles));form=new();policies=await ApiClient.GetApprovalsAsync();Show("Approval policy created.",false);}catch(AdministrationApiException ex){Show(ex.Message,true);}} private async Task ToggleAsync(ApprovalPolicyResponse policy){try{await ApiClient.UpdateApprovalAsync(policy.Id,new(policy.Name,policy.MinimumAmount,policy.MaximumAmount,policy.ApprovalMode,policy.RequiredRoles,!policy.IsActive,policy.Version));policies=await ApiClient.GetApprovalsAsync();Show("Approval policy updated.",false);}catch(AdministrationApiException ex){Show(ex.Message,true);}} private void Show(string text,bool isError){message=text;error=isError;} private static string Range(ApprovalPolicyResponse policy)=>policy.MinimumAmount is null && policy.MaximumAmount is null?"All values":$"PKR {policy.MinimumAmount?.ToString("N2") ?? "0.00"} to {policy.MaximumAmount?.ToString("N2") ?? "unlimited"}"; }
