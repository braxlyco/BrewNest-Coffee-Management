@page "/administration/settings"
@attribute [Authorize(Policy = AdministrationPermissionNames.SettingsRead)]
@inject AdministrationApiClient ApiClient
@inject IdentitySessionState Session

<PageTitle>Operational settings · BrewNest</PageTitle>
<section class="identity-heading"><div><span class="kicker">ADMINISTRATION</span><h1>Operational settings</h1><p>Company, branch, expiry, fiscal, numbering, and expense-allocation configuration.</p></div></section>
@if (message is not null) { <div class="identity-message @(error ? "error" : "success")">@message</div> }

<section class="identity-panel">
    <h2>Company</h2>
    <EditForm Model="company" OnValidSubmit="SaveCompanyAsync"><DataAnnotationsValidator /><FormValidationSummary />
        <div class="identity-form-grid"><div><label>Legal name</label><InputText class="form-control" @bind-Value="company.LegalName" /></div><div><label>Trading name</label><InputText class="form-control" @bind-Value="company.TradingName" /></div><div><label>Tax registration</label><InputText class="form-control" @bind-Value="company.TaxRegistrationNumber" /></div><div><label>Currency</label><InputText class="form-control" @bind-Value="company.CurrencyCode" /></div><div><label>Time zone</label><InputText class="form-control" @bind-Value="company.TimeZoneId" /></div><div><label>Email</label><InputText class="form-control" type="email" @bind-Value="company.Email" /></div><div><label>Phone (with country code)</label><InputText class="form-control" type="tel" inputmode="tel" maxlength="16" placeholder="+923001234567" @bind-Value="company.Phone" /></div><div><label>Address</label><InputText class="form-control" @bind-Value="company.Address" /></div></div>
        @if (CanManage) { <button class="identity-primary-button" type="submit">Save company</button> }
    </EditForm>
</section>

<div class="identity-two-column">
    <section class="identity-panel"><h2>Branches</h2>
        @foreach (var branch in branches) { <div class="identity-role-row"><span><strong>@branch.Code · @branch.Name</strong><small>@branch.Address · @branch.TimeZoneId</small></span><span class="identity-status @(branch.IsActive ? "active" : "inactive")">@(branch.IsActive ? "Active" : "Inactive")</span></div> }
        @if (CanManage) { <EditForm Model="branch" OnValidSubmit="CreateBranchAsync"><DataAnnotationsValidator /><FormValidationSummary /><div class="identity-form-grid"><div><label>Code</label><InputText class="form-control" @bind-Value="branch.Code" /></div><div><label>Name</label><InputText class="form-control" @bind-Value="branch.Name" /></div><div><label>Address</label><InputText class="form-control" @bind-Value="branch.Address" /></div><div><label>Time zone</label><InputText class="form-control" @bind-Value="branch.TimeZoneId" /></div></div><button class="identity-primary-button" type="submit">Add branch</button></EditForm> }
    </section>
    <section class="identity-panel"><h2>Expiry alerts</h2>
        @foreach (var alert in alerts) { <div class="identity-role-row"><span><strong>@alert.Name</strong><small>@alert.Severity threshold</small></span>@if(CanManage){<InputNumber class="form-control" style="max-width:7rem" @bind-Value="alertDays[alert.Id]" /><button class="identity-secondary-button" type="button" @onclick="() => SaveAlertAsync(alert)">Save</button>}else{<span>@alert.DaysBefore days</span>}</div> }
        <p>Defaults are 15, 7, and 3 days. Changes are validated so First &gt; Escalated &gt; Critical.</p>
    </section>
</div>

<div class="identity-two-column"><section class="identity-panel"><h2>Fiscal years</h2>@foreach (var item in fiscalYears) { <div class="identity-role-row"><span><strong>@item.Name</strong><small>@item.StartsOn — @item.EndsOn</small></span><span>@item.Status</span></div> }@if(CanManage){<EditForm Model="fiscalYear" OnValidSubmit="CreateFiscalYearAsync"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><div><label>Name</label><InputText class="form-control" @bind-Value="fiscalYear.Name"/></div><div><label>Start</label><InputDate class="form-control" @bind-Value="fiscalYear.StartsOn"/></div><div><label>End</label><InputDate class="form-control" @bind-Value="fiscalYear.EndsOn"/></div></div><button class="identity-primary-button" type="submit">Add fiscal year</button></EditForm>}</section><section class="identity-panel"><h2>Document numbering</h2>@foreach (var item in documentNumbers) { <div class="identity-role-row"><span><strong>@item.DocumentType</strong><small>@item.Preview · @item.ResetPolicy</small></span><span>@(item.IsActive ? "Active" : "Inactive")</span></div> }@if(CanManage){<EditForm Model="documentNumber" OnValidSubmit="CreateDocumentNumberAsync"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><div><label>Document type</label><InputText class="form-control" @bind-Value="documentNumber.DocumentType"/></div><div><label>Prefix</label><InputText class="form-control" @bind-Value="documentNumber.Prefix"/></div><div><label>Next number</label><InputNumber class="form-control" @bind-Value="documentNumber.NextNumber"/></div><div><label>Padding</label><InputNumber class="form-control" @bind-Value="documentNumber.Padding"/></div><div><label>Reset</label><InputSelect class="form-control" @bind-Value="documentNumber.ResetPolicy"><option>Never</option><option>Yearly</option><option>Monthly</option></InputSelect></div></div><button class="identity-primary-button" type="submit">Add sequence</button></EditForm>}<h2>Expense allocation</h2>@foreach (var item in expenseAllocations) { <div class="identity-role-row"><span><strong>@item.Name</strong><small>@item.Method</small></span><span>@item.FixedPercentage</span></div> }@if(CanManage){<EditForm Model="expense" OnValidSubmit="CreateExpenseAsync"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><div><label>Name</label><InputText class="form-control" @bind-Value="expense.Name"/></div><div><label>Method</label><InputSelect class="form-control" @bind-Value="expense.Method"><option>RevenueShare</option><option>EqualByBranch</option><option>FixedPercentage</option></InputSelect></div><div><label>Fixed % (when applicable)</label><InputNumber class="form-control" @bind-Value="expense.FixedPercentage"/></div></div><button class="identity-primary-button" type="submit">Add allocation rule</button></EditForm>}</section></div>

@code {
    private CompanySettingsFormModel company = new(); private BranchFormModel branch = new(); private FiscalYearFormModel fiscalYear = new(); private DocumentNumberFormModel documentNumber = new(); private ExpenseAllocationFormModel expense = new();
    private readonly Dictionary<Guid,int> alertDays = [];
    private BranchResponse[] branches = []; private AlertSettingResponse[] alerts = []; private FiscalYearResponse[] fiscalYears = []; private DocumentNumberSequenceResponse[] documentNumbers = []; private ExpenseAllocationSettingResponse[] expenseAllocations = [];
    private string? message; private bool error; private bool CanManage => Session.CurrentUser?.Permissions.Contains(AdministrationPermissionNames.SettingsManage, StringComparer.Ordinal) == true;
    protected override async Task OnInitializedAsync() { try { await LoadAsync(); } catch (AdministrationApiException ex) { Show(ex.Message, true); } }
    private async Task LoadAsync() { var response = await ApiClient.GetCompanyAsync(); company = new() { LegalName=response.LegalName, TradingName=response.TradingName, TaxRegistrationNumber=response.TaxRegistrationNumber, CurrencyCode=response.CurrencyCode, TimeZoneId=response.TimeZoneId, Address=response.Address, Phone=response.Phone, Email=response.Email, Version=response.Version }; branches=await ApiClient.GetBranchesAsync(); alerts=await ApiClient.GetAlertsAsync(); foreach(var alert in alerts) alertDays[alert.Id]=alert.DaysBefore; fiscalYears=await ApiClient.GetFiscalYearsAsync(); documentNumbers=await ApiClient.GetDocumentNumbersAsync(); expenseAllocations=await ApiClient.GetExpenseAllocationsAsync(); }
    private async Task SaveCompanyAsync() { try { var response=await ApiClient.UpdateCompanyAsync(new(company.LegalName,company.TradingName,company.TaxRegistrationNumber,company.CurrencyCode,company.TimeZoneId,company.Address,company.Phone,company.Email,company.Version)); company.Version=response.Version; Show("Company settings saved.",false); } catch (AdministrationApiException ex) { Show(ex.Message,true); } }
    private async Task CreateBranchAsync() { try { await ApiClient.CreateBranchAsync(new(branch.Code,branch.Name,branch.Address,branch.TimeZoneId)); branch=new(); branches=await ApiClient.GetBranchesAsync(); Show("Branch created.",false); } catch (AdministrationApiException ex) { Show(ex.Message,true); } }
    private async Task SaveAlertAsync(AlertSettingResponse alert) { try { await ApiClient.UpdateAlertAsync(alert.Id,new(alertDays[alert.Id],alert.IsActive,alert.Version)); alerts=await ApiClient.GetAlertsAsync(); foreach(var item in alerts) alertDays[item.Id]=item.DaysBefore; Show("Alert threshold saved.",false); } catch(AdministrationApiException ex){Show(ex.Message,true);} }
    private async Task CreateFiscalYearAsync(){try{await ApiClient.CreateFiscalYearAsync(new(fiscalYear.Name,fiscalYear.StartsOn,fiscalYear.EndsOn));fiscalYear=new();fiscalYears=await ApiClient.GetFiscalYearsAsync();Show("Fiscal year created.",false);}catch(AdministrationApiException ex){Show(ex.Message,true);}}
    private async Task CreateDocumentNumberAsync(){try{await ApiClient.CreateDocumentNumberAsync(new(documentNumber.DocumentType,null,documentNumber.Prefix,documentNumber.NextNumber,documentNumber.Padding,documentNumber.Suffix,documentNumber.ResetPolicy));documentNumber=new();documentNumbers=await ApiClient.GetDocumentNumbersAsync();Show("Document sequence created.",false);}catch(AdministrationApiException ex){Show(ex.Message,true);}}
    private async Task CreateExpenseAsync(){try{await ApiClient.CreateExpenseAllocationAsync(new(expense.Name,expense.Method,null,expense.FixedPercentage));expense=new();expenseAllocations=await ApiClient.GetExpenseAllocationsAsync();Show("Expense-allocation rule created.",false);}catch(AdministrationApiException ex){Show(ex.Message,true);}}
    private void Show(string text,bool isError){message=text;error=isError;}
}
