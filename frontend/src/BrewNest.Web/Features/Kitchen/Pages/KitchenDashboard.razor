@page "/kitchen"
@attribute [Authorize]
@inject IdentitySessionState Session
<PageTitle>Kitchen · BrewNest</PageTitle>
<section class="identity-heading"><span class="kicker">LIVE PRODUCTION</span><h1>Kitchen & KOT</h1><p>Generate controlled kitchen tickets, reserve recipe ingredients, and follow preparation in real time.</p></section>
<div class="identity-grid">@if(Has(KitchenPermissionNames.QueueRead)){<a class="identity-action-card" href="kitchen/queue"><strong>Kitchen queue</strong><span>Live queued, preparing, and ready tickets</span></a>}@if(Has(KitchenPermissionNames.QueueRead)){<a class="identity-action-card" href="kitchen/history"><strong>Status history</strong><span>Auditable preparation transitions</span></a>}</div>
@code { private bool Has(string permission) => Session.CurrentUser?.Permissions.Contains(permission, StringComparer.Ordinal) == true; }
