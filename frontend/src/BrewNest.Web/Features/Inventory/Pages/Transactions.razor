@page "/inventory/transactions"
@attribute [Authorize(Policy=InventoryPermissionNames.StockRead)]
@inject InventoryApiClient Api
@inject IdentitySessionState Session
<PageTitle>Stock controls · BrewNest</PageTitle>
<section class="identity-heading"><span class="kicker">INVENTORY</span><h1>Stock controls</h1><p>Every issue, adjustment, wastage, block, and unblock produces an auditable ledger entry.</p></section>
@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
@if(CanManage){<section class="identity-panel"><h2>Goods issue</h2><EditForm Model="issue" OnValidSubmit="Issue"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><label>Lot<InputSelect class="form-control" @bind-Value="issue.LotId" @bind-Value:after="IssueLotChanged"><option value="">Select eligible lot</option>@foreach(var x in lots.Where(x=>!x.IsBlocked&&x.OnHandQuantity>0)){<option value="@x.Id">@ItemName(x.ItemId) - @x.LotNumber · @x.AvailableQuantity.ToString("N3") available</option>}</InputSelect></label><label>Reservation (optional)<InputSelect class="form-control" @bind-Value="issue.ReservationId"><option value="">No reservation</option>@foreach(var x in EligibleReservations){<option value="@x.Id">@ReservationLabel(x) · @x.RemainingQuantity.ToString("N3") reserved</option>}</InputSelect></label><label>Quantity<InputNumber class="form-control" @bind-Value="issue.Quantity" min="0.001" step="0.001"/></label><label>Reference type<InputText class="form-control" @bind-Value="issue.ReferenceType" maxlength="80"/></label><label>Reference number<InputText class="form-control" @bind-Value="issue.ReferenceNumber" maxlength="100"/></label><label>Remarks<InputText class="form-control" @bind-Value="issue.Remarks" maxlength="500"/></label></div><button class="identity-primary-button">Post issue</button></EditForm></section>}
<div class="identity-two-column">@if(CanAdjust){<section class="identity-panel"><h2>Stock adjustment</h2><EditForm Model="adjust" OnValidSubmit="Adjust"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-stack"><label>Lot<InputSelect class="form-control" @bind-Value="adjust.LotId"><option value="">Select lot</option>@foreach(var x in lots){<option value="@x.Id">@ItemName(x.ItemId) - @x.LotNumber</option>}</InputSelect></label><label>Quantity delta<InputNumber class="form-control" @bind-Value="adjust.QuantityDelta"/></label><label>Reference<InputText class="form-control" @bind-Value="adjust.ReferenceNumber"/></label><label>Reason<InputText class="form-control" @bind-Value="adjust.Reason"/></label></div><button class="identity-primary-button">Post adjustment</button></EditForm></section>}@if(CanWaste){<section class="identity-panel"><h2>Wastage</h2><EditForm Model="waste" OnValidSubmit="Waste"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-stack"><label>Lot<InputSelect class="form-control" @bind-Value="waste.LotId"><option value="">Select lot</option>@foreach(var x in lots){<option value="@x.Id">@ItemName(x.ItemId) - @x.LotNumber</option>}</InputSelect></label><label>Quantity<InputNumber class="form-control" @bind-Value="waste.Quantity"/></label><label>Reference<InputText class="form-control" @bind-Value="waste.ReferenceNumber"/></label><label>Reason<InputText class="form-control" @bind-Value="waste.Reason"/></label></div><button class="identity-primary-button">Record wastage</button></EditForm></section>}</div>
@if(CanManage){<section class="identity-panel"><h2>Lot blocking</h2><p>Expired lots are automatically blocked and cannot be unblocked. Manual blocks require a reason.</p>@foreach(var x in lots){<div class="identity-role-row"><span><strong>@ItemName(x.ItemId) - @x.LotNumber</strong><small>@(x.IsBlocked?x.BlockReason:"Eligible")</small></span><button class="identity-secondary-button" @onclick="()=>ToggleBlock(x)">@(x.IsBlocked?"Unblock":"Block")</button></div>}</section>}
@code {
    private StockLotResponse[] lots=[]; private ReservationResponse[] reservations=[]; private InventoryCatalogItemReference[] items=[]; private IssueForm issue=new(); private AdjustmentForm adjust=new(); private WastageForm waste=new(); private string? message; private bool error;
    private bool Has(string p)=>Session.CurrentUser?.Permissions.Contains(p,StringComparer.Ordinal)==true; private bool CanManage=>Has(InventoryPermissionNames.StockManage); private bool CanAdjust=>Has(InventoryPermissionNames.AdjustmentsManage); private bool CanWaste=>Has(InventoryPermissionNames.WastageManage);
    private ReservationResponse[] EligibleReservations=>reservations.Where(x=>x.StockLotId==Lot(issue.LotId)?.Id&&x.RemainingQuantity>0).ToArray();
    private void IssueLotChanged()=>issue.ReservationId=string.Empty;
    protected override async Task OnInitializedAsync()=>await Load(); private async Task Load(){try{var references=await Api.GetReferencesAsync();items=references.Items;lots=await Api.GetLotsAsync();reservations=await Api.GetReservationsAsync();}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private string ItemName(Guid id)=>items.FirstOrDefault(x=>x.Id==id)?.Name??"Inactive or unavailable item";
    private static string ReservationLabel(ReservationResponse reservation)=>reservation.ReferenceType switch {"KitchenKOT"=>"Kitchen ticket","ProductionOrder"=>"Production order",_=>$"{reservation.ReferenceType} - {reservation.ReferenceId}"};
    private StockLotResponse? Lot(string value)=>Guid.TryParse(value,out var id)?lots.SingleOrDefault(x=>x.Id==id):null;
    private async Task Issue(){var lot=Lot(issue.LotId);if(lot is null||lot.IsBlocked){Show("Select an eligible lot.",true);return;}Guid? reservationId=Guid.TryParse(issue.ReservationId,out var parsed)?parsed:null;var reservation=reservationId is null?null:EligibleReservations.SingleOrDefault(x=>x.Id==reservationId);if(reservationId is not null&&reservation is null){Show("Select a reservation for this lot.",true);return;}try{await Api.IssueAsync(new(lot.Id,reservationId,issue.Quantity,issue.ReferenceType,issue.ReferenceNumber,issue.Remarks,lot.Version,reservation?.Version));issue=new();await Load();Show("Goods issue posted.",false);}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private async Task Adjust(){var lot=Lot(adjust.LotId);if(lot is null){Show("Select a valid lot.",true);return;}try{await Api.AdjustAsync(new(lot.Id,adjust.QuantityDelta,adjust.Reason,adjust.ReferenceNumber,lot.Version));adjust=new();await Load();Show("Stock adjustment posted.",false);}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private async Task Waste(){var lot=Lot(waste.LotId);if(lot is null){Show("Select a valid lot.",true);return;}try{await Api.WasteAsync(new(lot.Id,waste.Quantity,waste.Reason,waste.ReferenceNumber,lot.Version));waste=new();await Load();Show("Wastage recorded.",false);}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private async Task ToggleBlock(StockLotResponse lot){try{await Api.SetBlockAsync(lot.Id,new(!lot.IsBlocked,lot.IsBlocked?"Manager released manual block.":"Manager applied manual block.",lot.Version));await Load();Show(lot.IsBlocked?"Lot unblocked.":"Lot blocked.",false);}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private void Show(string value,bool failed){message=value;error=failed;}
}
