@page "/inventory/reservations"
@attribute [Authorize(Policy=InventoryPermissionNames.ReservationsManage)]
@attribute [Authorize(Policy=InventoryPermissionNames.StockRead)]
@inject InventoryApiClient Api
<PageTitle>Reservations · BrewNest</PageTitle>
<section class="identity-heading"><span class="kicker">INVENTORY</span><h1>Reservations</h1><p>Reservations reduce available stock without changing physical on-hand stock.</p></section>
@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
<section class="identity-panel"><div class="identity-table-wrap"><table class="identity-table"><thead><tr><th>Used for</th><th>Item and lot</th><th>Quantity</th><th>Remaining</th><th>Status</th></tr></thead><tbody>@foreach(var x in reservations){<tr><td>@ReferenceLabel(x)</td><td>@LotLabel(x.StockLotId)</td><td>@x.Quantity.ToString("N3")</td><td>@x.RemainingQuantity.ToString("N3")</td><td>@x.Status</td></tr>}</tbody></table></div></section>
<div class="identity-two-column"><section class="identity-panel"><h2>Create reservation</h2><EditForm Model="reserve" OnValidSubmit="Create"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-stack"><label>Eligible lot<InputSelect class="form-control" @bind-Value="reserve.LotId"><option value="">Select lot</option>@foreach(var x in lots.Where(x=>!x.IsBlocked&&x.AvailableQuantity>0)){<option value="@x.Id">@LotLabel(x.Id) · @x.AvailableQuantity.ToString("N3") available</option>}</InputSelect></label><label>Quantity<InputNumber class="form-control" @bind-Value="reserve.Quantity"/></label><label>Used for<InputText class="form-control" @bind-Value="reserve.ReferenceType"/></label><label>Reference number<InputText class="form-control" @bind-Value="reserve.ReferenceId"/></label><label>Remarks<InputText class="form-control" @bind-Value="reserve.Remarks"/></label></div><button class="identity-primary-button">Reserve</button></EditForm></section>
<section class="identity-panel"><h2>Release reservation</h2><EditForm Model="release" OnValidSubmit="Release"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-stack"><label>Active reservation<InputSelect class="form-control" @bind-Value="release.ReservationId"><option value="">Select reservation</option>@foreach(var x in reservations.Where(x=>x.RemainingQuantity>0)){<option value="@x.Id">@ReferenceLabel(x) - @LotLabel(x.StockLotId) - @x.RemainingQuantity.ToString("N3") remaining</option>}</InputSelect></label><label>Quantity<InputNumber class="form-control" @bind-Value="release.Quantity"/></label><label>Reason<InputText class="form-control" @bind-Value="release.Reason"/></label></div><button class="identity-secondary-button">Release</button></EditForm></section></div>
@code {
    private StockLotResponse[] lots=[]; private ReservationResponse[] reservations=[]; private InventoryCatalogItemReference[] items=[]; private ReservationForm reserve=new(); private ReleaseForm release=new(); private string? message; private bool error;
    protected override async Task OnInitializedAsync()=>await Load(); private async Task Load(){try{var references=await Api.GetReferencesAsync();items=references.Items;lots=await Api.GetLotsAsync();reservations=await Api.GetReservationsAsync();}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private string LotLabel(Guid lotId){var lot=lots.FirstOrDefault(x=>x.Id==lotId);if(lot is null)return "Lot unavailable";var item=items.FirstOrDefault(x=>x.Id==lot.ItemId)?.Name??"Inactive item";return $"{item} - {lot.LotNumber}";}
    private static string ReferenceLabel(ReservationResponse reservation)=>reservation.ReferenceType switch {"KitchenKOT"=>"Kitchen ticket","ProductionOrder"=>"Production order",_=>$"{reservation.ReferenceType} - {reservation.ReferenceId}"};
    private async Task Create(){if(!Guid.TryParse(reserve.LotId,out var id)){Show("Select a valid lot.",true);return;}try{await Api.ReserveAsync(new(id,reserve.Quantity,reserve.ReferenceType,reserve.ReferenceId,reserve.ExpiresAt,reserve.Remarks));reserve=new();await Load();Show("Stock reserved.",false);}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private async Task Release(){if(!Guid.TryParse(release.ReservationId,out var id)){Show("Select a valid reservation.",true);return;}var selected=reservations.Single(x=>x.Id==id);try{await Api.ReleaseAsync(id,new(release.Quantity,release.Reason,selected.Version));release=new();await Load();Show("Reservation released.",false);}catch(InventoryApiException ex){Show(ex.Message,true);}}
    private void Show(string value,bool failed){message=value;error=failed;}
}
