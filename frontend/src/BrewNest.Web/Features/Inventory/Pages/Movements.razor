@page "/inventory/movements"
@attribute [Authorize(Policy=InventoryPermissionNames.StockRead)]
@inject InventoryApiClient Api
<PageTitle>Stock ledger · BrewNest</PageTitle>
<section class="identity-heading"><span class="kicker">INVENTORY</span><h1>Stock movement ledger</h1><p>Append-only evidence of each quantity and control event. Transaction history is never physically deleted.</p></section>
@if(message is not null){<div class="identity-message error">@message</div>}
<section class="identity-panel"><div class="identity-table-wrap"><table class="identity-table"><thead><tr><th>Time</th><th>Movement</th><th>Item and lot</th><th>Quantity</th><th>Balance after</th><th>Reference</th><th>Actor</th></tr></thead><tbody>@foreach(var x in movements){<tr><td>@x.PerformedAt.ToLocalTime().ToString("g")</td><td>@x.MovementType</td><td>@LotLabel(x.StockLotId)</td><td>@x.Quantity.ToString("N3")</td><td><small>On-hand @x.OnHandAfter.ToString("N3")</small><small>Reserved @x.ReservedAfter.ToString("N3")</small></td><td>@ReferenceLabel(x)<small>@x.Remarks</small></td><td>@x.PerformedBy</td></tr>}</tbody></table></div></section>
@code { private StockMovementResponse[] movements=[]; private StockLotResponse[] lots=[]; private InventoryCatalogItemReference[] items=[]; private string? message; protected override async Task OnInitializedAsync(){try{var references=await Api.GetReferencesAsync();items=references.Items;lots=await Api.GetLotsAsync();movements=await Api.GetMovementsAsync();}catch(InventoryApiException ex){message=ex.Message;}} private string LotLabel(Guid id){var lot=lots.FirstOrDefault(x=>x.Id==id);return lot is null?"Lot unavailable":$"{items.FirstOrDefault(x=>x.Id==lot.ItemId)?.Name??"Inactive item"} - {lot.LotNumber}";} private static string ReferenceLabel(StockMovementResponse x)=>x.ReferenceType switch {"KitchenKOT"=>"Kitchen ticket","ProductionOrder"=>"Production order",_=>$"{x.ReferenceType} - {x.ReferenceNumber}"}; }
