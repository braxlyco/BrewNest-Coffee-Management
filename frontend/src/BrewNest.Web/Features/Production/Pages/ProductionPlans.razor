@page "/production/plans"
@attribute [Authorize(Policy=ProductionPermissionNames.Read)]
@inject ProductionApiClient Api
@inject IdentitySessionState Session
<PageTitle>Production plans · BrewNest</PageTitle>
<section class="identity-heading"><span class="kicker">PRODUCTION</span><h1>Production plans</h1><p>Create dated output plans and release them into BOM-calculated orders.</p></section>
@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
<section class="identity-panel"><div class="identity-table-wrap"><table class="identity-table"><thead><tr><th>Plan</th><th>Date</th><th>Status</th><th>Lines</th><th>Action</th></tr></thead><tbody>@foreach(var plan in plans){<tr><td><strong>@plan.PlanNumber</strong><small>@plan.Name</small></td><td>@plan.PlannedDate</td><td><span class="identity-status">@plan.Status</span></td><td>@plan.Lines.Length</td><td>@if(CanManage&&plan.Status==ProductionPlanStatus.Draft){<button class="identity-primary-button" @onclick="()=>Release(plan)">Release</button><button class="identity-secondary-button" @onclick="()=>Cancel(plan)">Cancel</button>}</td></tr>}</tbody></table></div></section>
@if(CanManage){<section class="identity-panel"><h2>New plan</h2><EditForm Model="form" OnValidSubmit="Create"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><label>Name<InputText class="form-control" @bind-Value="form.Name"/></label><label>Planned date<InputDate class="form-control" @bind-Value="form.PlannedDate"/></label><label>Menu item<InputSelect class="form-control" @bind-Value="form.MenuItemId"><option value="">Select recipe item</option>@foreach(var item in references){<option value="@item.Id">@item.Code · @item.Name</option>}</InputSelect></label><label>Quantity<InputNumber class="form-control" @bind-Value="form.Quantity"/></label><label>Notes<InputText class="form-control" @bind-Value="form.Notes"/></label></div><button class="identity-primary-button">Create plan</button></EditForm></section>}
@code { private ProductionPlanResponse[] plans=[];private ProductionMenuItemReference[] references=[];private CreateProductionPlanForm form=new();private string? message;private bool error;private bool CanManage=>Session.CurrentUser?.Permissions.Contains(ProductionPermissionNames.PlansManage,StringComparer.Ordinal)==true;protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{plans=await Api.GetPlansAsync();references=await Api.GetReferencesAsync();}catch(ProductionApiException ex){Show(ex.Message,true);}}private async Task Create(){if(form.MenuItemId is null)return;try{await Api.CreatePlanAsync(new(form.Name,DateOnly.FromDateTime(form.PlannedDate),form.Notes,[new(form.MenuItemId.Value,form.Quantity)]));form=new();await Load();Show("Production plan created.",false);}catch(ProductionApiException ex){Show(ex.Message,true);}}private async Task Release(ProductionPlanResponse x){try{await Api.ReleasePlanAsync(x.Id,new("Approved for production.",x.Version));await Load();Show("Plan released and production orders generated.",false);}catch(ProductionApiException ex){Show(ex.Message,true);}}private async Task Cancel(ProductionPlanResponse x){try{await Api.CancelPlanAsync(x.Id,new("Plan cancelled.",x.Version));await Load();Show("Plan cancelled.",false);}catch(ProductionApiException ex){Show(ex.Message,true);}}private void Show(string text,bool failed){message=text;error=failed;} }
