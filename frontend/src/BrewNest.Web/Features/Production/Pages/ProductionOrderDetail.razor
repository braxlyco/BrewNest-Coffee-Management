@page "/production/orders/{Id:guid}"
@attribute [Authorize(Policy=ProductionPermissionNames.Read)]
@inject ProductionApiClient Api
@inject IdentitySessionState Session
<PageTitle>Production order · BrewNest</PageTitle>
@if(order is null){<section class="identity-heading"><h1>Production order</h1><p>Loading...</p></section>}else{<section class="identity-heading"><span class="kicker">@order.Status</span><h1>@order.OrderNumber</h1><p>Planned output @order.PlannedQuantity.ToString("0.###") · @ItemName(order.MenuItemId)</p></section>@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}<section class="identity-panel"><h2>Material requirements</h2><div class="identity-table-wrap"><table class="identity-table"><thead><tr><th>Ingredient</th><th>BOM</th><th>Expected waste</th><th>Required</th><th>Actual</th><th>Waste</th><th>Variance</th></tr></thead><tbody>@foreach(var requirement in order.Requirements){<tr><td>@ItemName(requirement.IngredientItemId)</td><td>@requirement.BomQuantity.ToString("N3")</td><td>@requirement.ExpectedWastage.ToString("N3")</td><td>@requirement.RequiredQuantity.ToString("N3")</td><td>@if(order.Status==ProductionOrderStatus.Released&&CanIssue){<input class="form-control" type="number" step="0.001" @bind="usage[requirement.IngredientItemId].Consumption"/>}else{@requirement.ActualConsumption.ToString("N3")}</td><td>@if(order.Status==ProductionOrderStatus.Released&&CanIssue){<input class="form-control" type="number" step="0.001" @bind="usage[requirement.IngredientItemId].Wastage"/>}else{@requirement.ActualWastage.ToString("N3")}</td><td>@requirement.Variance.ToString("N3")</td></tr>}</tbody></table></div><div class="identity-button-row">@if(order.Status==ProductionOrderStatus.Draft&&CanRelease){<button class="identity-primary-button" @onclick="Release">Reserve & release</button>}@if(order.Status==ProductionOrderStatus.Released&&CanIssue){<button class="identity-primary-button" @onclick="Issue">Post goods issue</button>}@if(order.Status==ProductionOrderStatus.InProgress&&CanComplete){<button class="identity-primary-button" @onclick="Complete">Complete production</button>}@if((order.Status is ProductionOrderStatus.Draft or ProductionOrderStatus.Released)&&CanRelease){<button class="identity-secondary-button" @onclick="Cancel">Cancel</button>}</div></section>}
@code { [Parameter]public Guid Id{get;set;}private ProductionOrderResponse? order;private ProductionCatalogItemReference[] itemNames=[];private readonly Dictionary<Guid,ProductionUsageForm> usage=[];private string? message;private bool error;private bool Has(string p)=>Session.CurrentUser?.Permissions.Contains(p,StringComparer.Ordinal)==true;private bool CanRelease=>Has(ProductionPermissionNames.OrdersRelease);private bool CanIssue=>Has(ProductionPermissionNames.MaterialsIssue);private bool CanComplete=>Has(ProductionPermissionNames.CompletionManage);protected override async Task OnParametersSetAsync()=>await Load();private async Task Load(){try{itemNames=await Api.GetItemNamesAsync();order=await Api.GetOrderAsync(Id);foreach(var x in order.Requirements)if(!usage.ContainsKey(x.IngredientItemId))usage[x.IngredientItemId]=new(){ItemId=x.IngredientItemId,Consumption=x.RequiredQuantity-x.ExpectedWastage,Wastage=x.ExpectedWastage};}catch(ProductionApiException ex){Show(ex.Message,true);}}private string ItemName(Guid id)=>itemNames.FirstOrDefault(x=>x.Id==id)?.Name??"Unavailable item";private async Task Release()=>await Act(()=>Api.ReleaseOrderAsync(Id,new("Released to production.",order!.Version)),"Materials reserved.");private async Task Issue(){if(usage.Values.Any(x=>x.Consumption<0||x.Wastage<0||x.Consumption+x.Wastage<=0)){Show("Every material needs a positive total actual quantity.",true);return;}await Act(()=>Api.IssueAsync(Id,new(usage.Values.Select(x=>new ProductionMaterialUsageRequest(x.ItemId,x.Consumption,x.Wastage)).ToArray(),"Actual production materials issued.",order!.Version)),"Goods issue posted.");}private async Task Complete()=>await Act(()=>Api.CompleteAsync(Id,new("Production completed.",order!.Version)),"Production completed.");private async Task Cancel()=>await Act(()=>Api.CancelOrderAsync(Id,new("Production order cancelled.",order!.Version)),"Production order cancelled.");private async Task Act(Func<Task<ProductionOrderResponse>> action,string success){try{order=await action();Show(success,false);}catch(ProductionApiException ex){Show(ex.Message,true);}}private void Show(string text,bool failed){message=text;error=failed;} }
