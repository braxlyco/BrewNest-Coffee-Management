@page "/sales/orders/{Id:guid}"
@attribute [Authorize(Policy=SalesPermissionNames.OrdersRead)]
@inject SalesApiClient Api
@inject IdentitySessionState Session
<PageTitle>Sales order · BrewNest</PageTitle>
@if(order is null){<p>Loading order…</p>}else{
<section class="identity-heading"><span class="kicker">@order.OrderType.ToString().ToUpperInvariant()</span><h1>@order.OrderNumber</h1><p>@order.Status · @(string.IsNullOrWhiteSpace(order.CustomerName)?"Walk-in":order.CustomerName) · PKR @order.NetAmount.ToString("N2")</p></section>
@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
<section class="identity-panel"><h2>Order items</h2><div class="identity-table-wrap"><table class="identity-table"><thead><tr><th>Item</th><th>Qty</th><th>Unit price</th><th>Total</th><th>Instructions</th><th></th></tr></thead><tbody>@foreach(var x in order.Lines){<tr><td>@x.ItemCode · @x.ItemName @if(x.IsCancelled){<small>Cancelled: @x.CancellationReason</small>}</td><td>@x.Quantity</td><td>@x.UnitPrice.ToString("N2")</td><td>@x.LineTotal.ToString("N2")</td><td>@x.SpecialInstructions</td><td>@if(CanManage&&CanAmend&&!x.IsCancelled){<button class="identity-link-button" @onclick="()=>CancelLine(x)">Cancel line</button>}</td></tr>}</tbody></table></div><div class="identity-button-row"><strong>Gross: PKR @order.GrossAmount.ToString("N2")</strong><strong>Discount: PKR @order.DiscountAmount.ToString("N2")</strong><strong>Net: PKR @order.NetAmount.ToString("N2")</strong></div></section>
@if(CanManage&&CanAmend){<section class="identity-panel"><h2>Add item</h2><EditForm Model="line" OnValidSubmit="AddLine"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><label>Menu item<InputSelect class="form-control" @bind-Value="line.MenuItemId"><option value="">Select item</option>@foreach(var x in references.MenuItems){<option value="@x.Id">@x.Code · @x.Name · PKR @x.SalesPrice.ToString("N2")</option>}</InputSelect></label><label>Quantity<InputNumber class="form-control" @bind-Value="line.Quantity"/></label><label>Instructions<InputText class="form-control" @bind-Value="line.Instructions"/></label></div><button class="identity-primary-button">Add item</button></EditForm></section>}
<div class="identity-two-column"><section class="identity-panel"><h2>Discounts</h2>@foreach(var x in order.Discounts){<div class="identity-role-row"><span><strong>@x.Percentage% · PKR @x.Amount.ToString("N2")</strong><small>@x.Reason · requested by @x.RequestedBy</small></span><span>@x.Status</span></div>}@if(CanRequest&&CanAmend){<EditForm Model="discount" OnValidSubmit="RequestDiscount"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-stack"><label>Percentage<InputNumber class="form-control" @bind-Value="discount.Percentage"/></label><label>Reason<InputText class="form-control" @bind-Value="discount.Reason"/></label></div><button class="identity-primary-button">Request manager approval</button></EditForm>}</section><section class="identity-panel"><h2>Bill</h2>@if(order.Bill is null){<p>No final bill has been issued.</p>}else{<p><strong>@order.Bill.BillNumber</strong></p><p>Gross PKR @order.Bill.GrossAmount.ToString("N2")<br/>Discount PKR @order.Bill.DiscountAmount.ToString("N2")<br/><strong>Net PKR @order.Bill.NetAmount.ToString("N2")</strong></p>}</section></div>
<section class="identity-panel"><h2>Workflow</h2><div class="identity-button-row">@if(CanBill&&order.Status==SalesOrderStatus.Draft){<button class="identity-primary-button" @onclick="Confirm">Confirm order</button>}@if(CanBill&&order.Status==SalesOrderStatus.Confirmed){<button class="identity-primary-button" @onclick="Bill">Issue final bill</button>}@if(CanClose&&order.Status==SalesOrderStatus.Billed){<button class="identity-primary-button" @onclick="Close">Close order</button>}@if(CanClose&&CanAmend){<button class="identity-secondary-button" @onclick="Cancel">Cancel order</button>}</div></section>
<section class="identity-panel"><h2>Status history</h2>@foreach(var x in history){<div class="identity-role-row"><span><strong>@x.PreviousStatus → @x.NewStatus</strong><small>@x.Reason · @x.ChangedBy</small></span><span>@x.ChangedAt.ToLocalTime().ToString("g")</span></div>}</section>}
@code {
    [Parameter]public Guid Id{get;set;}private SalesOrderResponse? order;private SalesReferenceDataResponse references=new([],[],[]);private SalesStatusHistoryResponse[] history=[];private AddLineForm line=new();private DiscountForm discount=new();private string? message;private bool error;
    private bool Has(string p)=>Session.CurrentUser?.Permissions.Contains(p,StringComparer.Ordinal)==true;private bool CanManage=>Has(SalesPermissionNames.OrdersManage);private bool CanRequest=>Has(SalesPermissionNames.DiscountsRequest);private bool CanBill=>Has(SalesPermissionNames.BillingManage);private bool CanClose=>Has(SalesPermissionNames.OrdersClose);private bool CanAmend=>order?.Status is SalesOrderStatus.Draft or SalesOrderStatus.Confirmed;
    protected override async Task OnParametersSetAsync()=>await Load();private async Task Load(){try{order=await Api.GetOrderAsync(Id);references=await Api.GetReferencesAsync();history=await Api.GetHistoryAsync(Id);}catch(SalesApiException ex){Show(ex.Message,true);}}
    private async Task AddLine(){if(order is null||line.MenuItemId is null)return;try{order=await Api.AddLineAsync(Id,new(line.MenuItemId.Value,line.Quantity,line.Instructions,order.Version));line=new();await RefreshHistory();Show("Item added.",false);}catch(SalesApiException ex){Show(ex.Message,true);}}
    private async Task CancelLine(SalesOrderLineResponse value){if(order is null)return;try{order=await Api.UpdateLineAsync(Id,value.Id,new(value.Quantity,true,"Cancelled by operator.",order.Version,value.Version));Show("Line cancelled.",false);}catch(SalesApiException ex){Show(ex.Message,true);}}
    private async Task RequestDiscount(){if(order is null)return;try{order=await Api.RequestDiscountAsync(Id,new(discount.Percentage,discount.Reason,order.Version));discount=new();Show("Discount submitted for manager approval.",false);}catch(SalesApiException ex){Show(ex.Message,true);}}
    private Task Confirm()=>Change((id,x)=>Api.ConfirmAsync(id,x),"Order confirmed.");private Task Bill()=>Change((id,x)=>Api.BillAsync(id,x),"Final bill issued.");private Task Close()=>Change((id,x)=>Api.CloseAsync(id,x),"Order closed.");private Task Cancel()=>Change((id,x)=>Api.CancelAsync(id,x),"Cancelled by operator.");
    private async Task Change(Func<Guid,ChangeSalesOrderStatusRequest,Task<SalesOrderResponse>> action,string reason){if(order is null)return;try{order=await action(Id,new(reason,order.Version));await RefreshHistory();Show(reason,false);}catch(SalesApiException ex){Show(ex.Message,true);}}private async Task RefreshHistory()=>history=await Api.GetHistoryAsync(Id);private void Show(string value,bool failed){message=value;error=failed;}
}
