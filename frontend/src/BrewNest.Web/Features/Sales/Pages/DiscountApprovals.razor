@page "/sales/discount-approvals"
@attribute [Authorize(Policy=SalesPermissionNames.DiscountsApprove)]
@attribute [Authorize(Policy=SalesPermissionNames.OrdersRead)]
@inject SalesApiClient Api
<PageTitle>Discount approvals · BrewNest</PageTitle>
<section class="identity-heading"><span class="kicker">MANAGER CONTROL</span><h1>Discount approvals</h1><p>Every discount must be explicitly approved before a final bill can be issued.</p></section>
@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
@foreach(var entry in Pending){<section class="identity-panel"><h2>@entry.Order.OrderNumber</h2><p>@entry.Discount.Percentage% · PKR @entry.Discount.Amount.ToString("N2") · @entry.Discount.Reason</p><p>Requested by @entry.Discount.RequestedBy on @entry.Discount.RequestedAt.ToLocalTime().ToString("g")</p><div class="identity-button-row"><button class="identity-primary-button" @onclick="()=>Decide(entry,true)">Approve</button><button class="identity-secondary-button" @onclick="()=>Decide(entry,false)">Reject</button><a href="sales/orders/@entry.Order.Id">Review order</a></div></section>}@if(!Pending.Any()){<section class="identity-panel"><p>No pending discount requests.</p></section>}
@code { private SalesOrderResponse[] orders=[];private string? message;private bool error;private IEnumerable<(SalesOrderResponse Order,SalesDiscountResponse Discount)> Pending=>orders.SelectMany(order=>order.Discounts.Where(x=>x.Status==SalesDiscountStatus.Pending).Select(discount=>(order,discount)));protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{orders=await Api.GetOrdersAsync();}catch(SalesApiException ex){Show(ex.Message,true);}}private async Task Decide((SalesOrderResponse Order,SalesDiscountResponse Discount) entry,bool approve){try{await Api.DecideDiscountAsync(entry.Order.Id,entry.Discount.Id,new(approve,approve?"Approved by manager.":"Rejected by manager.",entry.Order.Version,entry.Discount.Version));await Load();Show(approve?"Discount approved.":"Discount rejected.",false);}catch(SalesApiException ex){Show(ex.Message,true);}}private void Show(string value,bool failed){message=value;error=failed;}}
