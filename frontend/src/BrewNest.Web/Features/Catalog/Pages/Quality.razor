@page "/catalog/quality"
@attribute [Authorize(Policy=CatalogPermissionNames.QualityRead)]
@inject CatalogApiClient Api
@inject IdentitySessionState Session
<PageTitle>Quality configuration · BrewNest</PageTitle><section class="identity-heading"><div><span class="kicker">CATALOG QUALITY</span><h1>Inspection requirements</h1><p>Configurable criteria determine whether received material may enter unrestricted stock.</p></div></section>@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
<section class="identity-panel"><h2>Requirements</h2>@foreach(var x in requirements){<div class="identity-role-row"><span><strong>@x.Name</strong><small>@x.Criteria.Length criterion/criteria · Required: @(x.IsRequired?"Yes":"No")</small></span><span>@(x.IsActive?"Active":"Inactive")</span></div>}@if(CanManage){<EditForm Model="form" OnValidSubmit="Create"><DataAnnotationsValidator/><FormValidationSummary /><p>Select either an item or an item group.</p><div class="identity-form-grid"><Field Label="Item"><InputSelect class="form-control" @bind-Value="form.ItemId"><option value="">None</option>@foreach(var x in items){<option value="@x.Id">@x.Code · @x.Name</option>}</InputSelect></Field><Field Label="Item group"><InputSelect class="form-control" @bind-Value="form.GroupId"><option value="">None</option>@foreach(var x in groups){<option value="@x.Id">@x.Code · @x.Name</option>}</InputSelect></Field><Field Label="Requirement name"><InputText class="form-control" @bind-Value="form.Name"/></Field><Field Label="Criterion"><InputText class="form-control" @bind-Value="form.CriterionName"/></Field><Field Label="Result type"><InputSelect class="form-control" @bind-Value="form.ResultType"><option>PassFail</option><option>Numeric</option><option>Text</option></InputSelect></Field><Field Label="Minimum"><InputText class="form-control" @bind-Value="form.MinimumValue"/></Field><Field Label="Maximum"><InputText class="form-control" @bind-Value="form.MaximumValue"/></Field><Field Label="Unit"><InputText class="form-control" @bind-Value="form.Unit"/></Field></div><label><InputCheckbox @bind-Value="form.IsMandatory"/> Mandatory criterion</label><button class="identity-primary-button">Create requirement</button></EditForm>}</section>
@code{private InspectionRequirementResponse[] requirements=[];private CatalogItemResponse[] items=[];private ItemGroupResponse[] groups=[];private InspectionForm form=new();private string? message;private bool error;private bool CanManage=>Session.CurrentUser?.Permissions.Contains(CatalogPermissionNames.QualityManage,StringComparer.Ordinal)==true;protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{requirements=await Api.GetInspectionsAsync();items=(await Api.GetItemsAsync()).Where(x=>x.IsActive).ToArray();groups=(await Api.GetGroupsAsync()).Where(x=>x.IsActive).ToArray();}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task Create(){try{await Api.CreateInspectionAsync(new(form.ItemId,form.GroupId,form.Name,true,[new(form.CriterionName,form.ResultType,form.MinimumValue,form.MaximumValue,form.Unit,form.IsMandatory,1)]));form=new();await Load();Show("Inspection requirement created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private void Show(string x,bool failed){message=x;error=failed;}}
