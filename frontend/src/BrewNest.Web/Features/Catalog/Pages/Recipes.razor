@page "/catalog/recipes"
@attribute [Authorize(Policy=CatalogPermissionNames.RecipesRead)]
@inject CatalogApiClient Api
@inject IdentitySessionState Session
<PageTitle>Recipes / BOMs · BrewNest</PageTitle><section class="identity-heading"><div><span class="kicker">CATALOG</span><h1>Recipes / BOMs</h1><p>Version-friendly material definitions only; production planning and consumption remain outside Catalog.</p></div></section>@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
<section class="identity-panel"><h2>Recipes</h2>@foreach(var x in recipes){<div class="identity-role-row"><span><strong>@x.Code · @x.Name</strong><small>Yield @x.YieldQuantity · @x.Lines.Length material line(s)</small></span><span>@(x.IsActive?"Active":"Inactive")</span></div>}@if(CanManage){<EditForm Model="form" OnValidSubmit="Create"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><Field Label="Code"><InputText class="form-control" @bind-Value="form.Code"/></Field><Field Label="Name"><InputText class="form-control" @bind-Value="form.Name"/></Field><Field Label="Menu item"><InputSelect class="form-control" @bind-Value="form.MenuItemId"><option value="">Select</option>@foreach(var x in menuItems){<option value="@x.Id">@x.Code · @x.Name</option>}</InputSelect></Field><Field Label="Yield"><InputNumber class="form-control" @bind-Value="form.YieldQuantity"/></Field><Field Label="Yield unit"><InputSelect class="form-control" @bind-Value="form.YieldUnitId"><option value="">Select</option>@foreach(var x in units){<option value="@x.Id">@x.Code</option>}</InputSelect></Field><Field Label="Ingredient / packaging"><InputSelect class="form-control" @bind-Value="form.IngredientId"><option value="">Select</option>@foreach(var x in ingredients){<option value="@x.Id">@x.Code · @x.Name</option>}</InputSelect></Field><Field Label="Quantity"><InputNumber class="form-control" @bind-Value="form.IngredientQuantity"/></Field><Field Label="Wastage %"><InputNumber class="form-control" @bind-Value="form.WastagePercentage"/></Field></div><button class="identity-primary-button">Create recipe</button></EditForm>}</section>
@code{private RecipeResponse[] recipes=[];private CatalogItemResponse[] menuItems=[],ingredients=[];private UnitOfMeasureResponse[] units=[];private RecipeForm form=new();private string? message;private bool error;private bool CanManage=>Session.CurrentUser?.Permissions.Contains(CatalogPermissionNames.RecipesManage,StringComparer.Ordinal)==true;protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{recipes=await Api.GetRecipesAsync();var items=await Api.GetItemsAsync();menuItems=items.Where(x=>x.ItemType=="MenuItem"&&x.IsActive).ToArray();ingredients=items.Where(x=>x.ItemType!="MenuItem"&&x.IsActive).ToArray();units=(await Api.GetUnitsAsync()).Where(x=>x.IsActive).ToArray();}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task Create(){if(form.MenuItemId is null||form.YieldUnitId is null||form.IngredientId is null)return;try{await Api.CreateRecipeAsync(new(form.Code,form.Name,form.MenuItemId.Value,form.YieldQuantity,form.YieldUnitId.Value,[new(form.IngredientId.Value,form.IngredientQuantity,form.WastagePercentage,1)]));form=new();await Load();Show("Recipe created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private void Show(string x,bool failed){message=x;error=failed;}}
