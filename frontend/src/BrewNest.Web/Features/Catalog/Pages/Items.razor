@page "/catalog/items"
@attribute [Authorize(Policy=CatalogPermissionNames.MasterDataRead)]
@inject CatalogApiClient Api
@inject IdentitySessionState Session
<PageTitle>Items & units · BrewNest</PageTitle>
<section class="identity-heading"><div><span class="kicker">CATALOG</span><h1>Items & units</h1><p>Menu items, raw materials, packaging materials, item groups, and measurement units.</p></div></section>
@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
<div class="identity-two-column"><section class="identity-panel"><h2>Units of measure</h2>@foreach(var x in units){<div class="identity-role-row"><span><strong>@x.Code · @x.Name</strong><small>@x.Symbol · @x.Category · @x.DecimalPlaces decimals</small></span><span>@(x.IsActive?"Active":"Inactive")</span></div>}@if(CanManage){<EditForm Model="unit" OnValidSubmit="CreateUnit"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><Field Label="Code"><InputText class="form-control" @bind-Value="unit.Code"/></Field><Field Label="Name"><InputText class="form-control" @bind-Value="unit.Name"/></Field><Field Label="Symbol"><InputText class="form-control" @bind-Value="unit.Symbol"/></Field><Field Label="Category"><InputText class="form-control" list="unit-category-options" @bind-Value="unit.Category"/><datalist id="unit-category-options"><option value="Count"/><option value="Mass"/><option value="Volume"/><option value="Length"/>@foreach(var category in units.Select(x=>x.Category).Distinct().OrderBy(x=>x)){<option value="@category"/>}</datalist></Field><Field Label="Decimals"><InputNumber class="form-control" @bind-Value="unit.DecimalPlaces"/></Field></div><button class="identity-primary-button">Add unit</button></EditForm>}</section>
<section class="identity-panel"><h2>Item groups</h2>@foreach(var x in groups){<div class="identity-role-row"><span><strong>@x.Code · @x.Name</strong><small>@(x.AppliesTo.Length==0?"All item types":x.AppliesTo) · Inspection: @(x.RequiresInspection?"Yes":"No")</small></span><span>@(x.IsActive?"Active":"Inactive")</span></div>}@if(CanManage){<EditForm Model="group" OnValidSubmit="CreateGroup"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><Field Label="Code"><InputText class="form-control" @bind-Value="group.Code"/></Field><Field Label="Name"><InputText class="form-control" @bind-Value="group.Name"/></Field><Field Label="Applies to"><InputSelect class="form-control" @bind-Value="group.AppliesTo"><option value="">All</option><option>MenuItem</option><option>RawMaterial</option><option>PackagingMaterial</option></InputSelect></Field><label><InputCheckbox @bind-Value="group.RequiresInspection"/> Requires inspection</label></div><button class="identity-primary-button">Add group</button></EditForm>}</section></div>
<section class="identity-panel"><h2>Catalog items</h2>@foreach(var x in items){<div class="identity-role-row"><span><strong>@x.Code · @x.Name</strong><small>@x.ItemType · Cost @x.StandardCost.ToString("N2") @if(x.SalesPrice is not null){<text> · Price @x.SalesPrice.Value.ToString("N2")</text>}</small></span><span class="identity-status @(x.IsActive?"active":"inactive")">@(x.IsActive?"Active":"Inactive")</span></div>}@if(CanManage){<EditForm Model="item" OnValidSubmit="CreateItem"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><Field Label="Code"><InputText class="form-control" @bind-Value="item.Code"/></Field><Field Label="Name"><InputText class="form-control" @bind-Value="item.Name"/></Field><Field Label="Type"><InputSelect class="form-control" @bind-Value="item.ItemType" @bind-Value:after="OnItemTypeChanged"><option>MenuItem</option><option>RawMaterial</option><option>PackagingMaterial</option></InputSelect></Field><Field Label="Unit"><InputSelect class="form-control" @bind-Value="item.UnitId"><option value="">Select a unit</option>@foreach(var x in units.Where(x=>x.IsActive)){<option value="@x.Id">@x.Code · @x.Name (@x.Symbol)</option>}</InputSelect></Field><Field Label="Group"><InputSelect class="form-control" @bind-Value="item.GroupId"><option value="">No group</option>@foreach(var x in AvailableGroups){<option value="@x.Id">@x.Code · @x.Name</option>}</InputSelect></Field>@if(item.ItemType=="MenuItem"){<Field Label="Sales price"><InputNumber class="form-control" @bind-Value="item.SalesPrice"/></Field>}<Field Label="Standard cost"><InputNumber class="form-control" @bind-Value="item.StandardCost"/></Field><Field Label="Shelf-life days"><InputNumber class="form-control" @bind-Value="item.ShelfLifeDays"/></Field></div><Field Label="Description"><InputTextArea class="form-control" @bind-Value="item.Description"/></Field><label><InputCheckbox @bind-Value="item.RequiresInspection"/> Requires inspection</label><button class="identity-primary-button">Add item</button></EditForm>}</section>
@code{private UnitOfMeasureResponse[] units=[];private ItemGroupResponse[] groups=[];private CatalogItemResponse[] items=[];private UnitForm unit=new();private GroupForm group=new();private ItemForm item=new();private string? message;private bool error;private bool CanManage=>Session.CurrentUser?.Permissions.Contains(CatalogPermissionNames.MasterDataManage,StringComparer.Ordinal)==true;private IEnumerable<ItemGroupResponse> AvailableGroups=>groups.Where(x=>x.IsActive&&(x.AppliesTo.Length==0||x.AppliesTo==item.ItemType));private void OnItemTypeChanged(){if(item.GroupId is Guid selected&&!AvailableGroups.Any(x=>x.Id==selected))item.GroupId=null;if(item.ItemType!="MenuItem")item.SalesPrice=null;}protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{units=await Api.GetUnitsAsync();groups=await Api.GetGroupsAsync();items=await Api.GetItemsAsync();}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task CreateUnit(){try{await Api.CreateUnitAsync(new(unit.Code,unit.Name,unit.Symbol,unit.Category,unit.DecimalPlaces));unit=new();await Load();Show("Unit created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task CreateGroup(){try{await Api.CreateGroupAsync(new(group.Code,group.Name,group.AppliesTo,group.RequiresInspection));group=new();await Load();Show("Item group created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task CreateItem(){if(item.UnitId is null)return;try{await Api.CreateItemAsync(new(item.Code,item.Name,item.Description,item.ItemType,item.UnitId.Value,item.GroupId,item.SalesPrice,item.StandardCost,item.ShelfLifeDays,item.RequiresInspection));item=new();await Load();Show("Item created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private void Show(string text,bool failed){message=text;error=failed;}}
