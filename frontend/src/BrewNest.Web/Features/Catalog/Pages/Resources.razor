@page "/catalog/resources"
@attribute [Authorize(Policy=CatalogPermissionNames.MasterDataRead)]
@inject CatalogApiClient Api
@inject IdentitySessionState Session
<PageTitle>Service resources · BrewNest</PageTitle><section class="identity-heading"><div><span class="kicker">CATALOG</span><h1>Service resources</h1><p>Dining tables, warehouses, and rider profiles. No stock or delivery transactions are stored here.</p></div></section>@if(message is not null){<div class="identity-message @(error?"error":"success")">@message</div>}
<div class="identity-two-column"><section class="identity-panel"><h2>Dining tables</h2>@foreach(var x in tables){<div class="identity-role-row"><span><strong>@x.Code · @x.Name</strong><small>@x.Area · @x.Capacity seats</small></span><span>@(x.IsActive?"Active":"Inactive")</span></div>}@if(CanManage){<EditForm Model="table" OnValidSubmit="CreateTable"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><Field Label="Code"><InputText class="form-control" @bind-Value="table.Code"/></Field><Field Label="Name"><InputText class="form-control" @bind-Value="table.Name"/></Field><Field Label="Capacity"><InputNumber class="form-control" @bind-Value="table.Capacity"/></Field><Field Label="Area"><InputText class="form-control" @bind-Value="table.Area"/></Field></div><button class="identity-primary-button">Add table</button></EditForm>}</section><section class="identity-panel"><h2>Warehouses</h2>@foreach(var x in warehouses){<div class="identity-role-row"><span><strong>@x.Code · @x.Name</strong><small>@x.Address</small></span><span>@(x.IsActive?"Active":"Inactive")</span></div>}@if(CanManage){<EditForm Model="warehouse" OnValidSubmit="CreateWarehouse"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><Field Label="Code"><InputText class="form-control" @bind-Value="warehouse.Code"/></Field><Field Label="Name"><InputText class="form-control" @bind-Value="warehouse.Name"/></Field><Field Label="Address"><InputText class="form-control" @bind-Value="warehouse.Address"/></Field></div><button class="identity-primary-button">Add warehouse</button></EditForm>}</section></div>
<section class="identity-panel"><h2>Riders</h2>@foreach(var x in riders){<div class="identity-role-row"><span><strong>@x.Code · @x.Name</strong><small>@x.Phone · @x.VehicleRegistration</small></span><span>@(x.IsActive?(x.IsAvailable?"Available":"Unavailable"):"Inactive")</span></div>}@if(CanManage){<EditForm Model="rider" OnValidSubmit="CreateRider"><DataAnnotationsValidator/><FormValidationSummary /><div class="identity-form-grid"><Field Label="Code"><InputText class="form-control" @bind-Value="rider.Code"/></Field><Field Label="Name"><InputText class="form-control" @bind-Value="rider.Name"/></Field><Field Label="Phone (country code required)"><InputText class="form-control" type="tel" inputmode="tel" maxlength="16" placeholder="+923001234567" @bind-Value="rider.Phone"/></Field><Field Label="Vehicle"><InputText class="form-control" @bind-Value="rider.VehicleRegistration"/></Field></div><label><InputCheckbox @bind-Value="rider.IsAvailable"/> Available</label><button class="identity-primary-button">Add rider</button></EditForm>}</section>
@code{private DiningTableResponse[] tables=[];private WarehouseResponse[] warehouses=[];private RiderResponse[] riders=[];private TableForm table=new();private WarehouseForm warehouse=new();private RiderForm rider=new();private string? message;private bool error;private bool CanManage=>Session.CurrentUser?.Permissions.Contains(CatalogPermissionNames.MasterDataManage,StringComparer.Ordinal)==true;protected override async Task OnInitializedAsync()=>await Load();private async Task Load(){try{tables=await Api.GetTablesAsync();warehouses=await Api.GetWarehousesAsync();riders=await Api.GetRidersAsync();}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task CreateTable(){try{await Api.CreateTableAsync(new(table.Code,table.Name,table.Capacity,table.Area));table=new();await Load();Show("Table created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task CreateWarehouse(){try{await Api.CreateWarehouseAsync(new(warehouse.Code,warehouse.Name,warehouse.Address));warehouse=new();await Load();Show("Warehouse created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private async Task CreateRider(){try{await Api.CreateRiderAsync(new(rider.Code,rider.Name,rider.Phone,rider.VehicleRegistration,rider.IsAvailable));rider=new();await Load();Show("Rider created.",false);}catch(CatalogApiException ex){Show(ex.Message,true);}}private void Show(string x,bool failed){message=x;error=failed;}}
